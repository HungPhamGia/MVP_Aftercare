# Supavisor SESSION pooler (port 5432), NOT db.[ref].supabase.co (IPv6-only).
# Username MUST carry the project ref: postgres.[PROJECT_REF]. URL-encode the password (@ -> %40, ! -> %21, ...).
# Scheme must be postgresql+psycopg for SQLAlchemy. Real creds go in .env (gitignored), never here.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Question generation (optional — template draft is used if unset).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GPT is the voicebot brain (uses OPENAI_API_KEY above). The Smartbot vars below
# are legacy/unused — the old VNPT Smartbot brain was replaced by GPT.
BOT_ID=
SMARTBOT_ACCESS_TOKEN=
SMARTBOT_TOKEN_ID=
SMARTBOT_TOKEN_KEY=
SMARTBOT_URL=https://assistant-stream.vnpt.vn/v1/conversation

# VNPT SmartVoice STT/TTS (optional — front end falls back to browser Web Speech
# for whichever service is unset). Separate creds per service. Server-side only.
# Base URL per your VNPT env (Postman collections use explorer.idg.vnpt.vn).
SMARTVOICE_BASE_URL=https://api.idg.vnpt.vn
# TTS voice. region: female_north | female_north_ngochoa | female_central |
# female_south | male_north | male_central | male_south. speed: 0.5-2 (1 = bình thường).
SMARTVOICE_TTS_REGION=female_north
SMARTVOICE_TTS_SPEED=1
SMARTVOICE_STT_ACCESS_TOKEN=
SMARTVOICE_STT_TOKEN_ID=
SMARTVOICE_STT_TOKEN_KEY=
SMARTVOICE_TTS_ACCESS_TOKEN=
SMARTVOICE_TTS_TOKEN_ID=
SMARTVOICE_TTS_TOKEN_KEY=
